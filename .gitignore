# Build output
build/
build-*/
cmake-build-*/

# Runtime output
out/

# Packaged release
pastiche-*-win64/
*.zip

# Models: only README is tracked, weights are downloaded or generated
models/*
!models/README.md

# Third-party binaries (ONNX Runtime, DirectML, downloaded weights)
third_party/

# Local collection of public-domain style images (not part of the release)
styles/

# Research papers and figures cut from them stay local (size and copyright)
research/*.pdf
research/*.png

# ImGui layout (user-local)
imgui.ini

# Local benchmark baseline (machine-specific)
benchmark_baseline.txt

# Claude Code local settings
.claude/

# Python
__pycache__/
*.pyc
